{
  "version": 2,
  "name": "Saw Bass",
  "engine": "instrument",
  "routing": "synth>delay>output",
  "modules": {
    "synth": {
      "waveform": "saw",
      "attack_ms": 8,
      "decay_ms": 180,
      "sustain": 0.45,
      "release_ms": 160,
      "cutoff_hz": 900
    },
    "delay": {
      "mix": 0.08,
      "time_ms": 150,
      "feedback": 0.1,
      "bypass": false
    },
    "output": {
      "level": 0.25
    }
  }
}
