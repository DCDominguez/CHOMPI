{
  "version": 5,
  "name": "Knob Pad (v5 knobs)",
  "engine": "instrument",
  "routing": "synth>delay>reverb>output",
  "modules": {
    "synth": {
      "waveform": "saw",
      "attack_ms": 900,
      "decay_ms": 1200,
      "sustain": 0.8,
      "release_ms": 2500,
      "osc2_waveform": "saw",
      "osc2_level": 0.8,
      "osc2_semitones": 0,
      "osc2_detune_cents": 9,
      "noise": 0.02,
      "voices": 4,
      "glide_ms": 0
    },
    "filter": {
      "cutoff_hz": 1400,
      "resonance": 0.15,
      "env_octaves": 1.5,
      "attack_ms": 1200,
      "decay_ms": 1800,
      "sustain": 0.3,
      "release_ms": 2500
    },
    "lfo": {
      "waveform": "sine",
      "rate_hz": 0.3,
      "pitch_cents": 6,
      "filter_octaves": 0.6,
      "amp_depth": 0,
      "mod_wheel": false
    },
    "sampler": {
      "mode": "chromatic",
      "bank": "a",
      "slot": 1,
      "pitch_semitones": 0,
      "start": 0,
      "end": 1,
      "loop": false,
      "hold": true,
      "reverse": false,
      "crossfade_ms": 10
    },
    "delay": {
      "mix": 0.2,
      "time_ms": 420,
      "feedback": 0.3,
      "bypass": false
    },
    "reverb": {
      "mix": 0.45,
      "size": 0.75,
      "damping": 0.55
    },
    "output": {
      "level": 0.25
    }
  },
  "knobs": [
    "filter.cutoff_hz",
    "lfo.rate_hz",
    "reverb.size",
    "reverb.mix"
  ]
}
