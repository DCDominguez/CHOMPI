{
  "version": 7,
  "name": "Arp Bells (v7 arp + bass)",
  "engine": "instrument",
  "routing": "synth>delay>reverb>output",
  "modules": {
    "synth": {
      "waveform": "sine",
      "attack_ms": 2,
      "decay_ms": 1600,
      "sustain": 0,
      "release_ms": 1800,
      "osc2_waveform": "sine",
      "osc2_level": 0.45,
      "osc2_semitones": 19,
      "osc2_detune_cents": 4,
      "noise": 0,
      "voices": 4,
      "glide_ms": 0
    },
    "filter": {
      "cutoff_hz": 9000,
      "resonance": 0.1,
      "env_octaves": 0,
      "attack_ms": 1,
      "decay_ms": 500,
      "sustain": 1,
      "release_ms": 500
    },
    "lfo": {
      "waveform": "sine",
      "rate_hz": 5.5,
      "pitch_cents": 12,
      "filter_octaves": 0,
      "amp_depth": 0.1,
      "mod_wheel": true
    },
    "sampler": {
      "mode": "chromatic",
      "bank": "a",
      "slot": 1,
      "pitch_semitones": 0,
      "start": 0,
      "end": 1,
      "loop": false,
      "hold": true,
      "reverse": false,
      "crossfade_ms": 10
    },
    "delay": {
      "mix": 0.25,
      "time_ms": 375,
      "feedback": 0.3,
      "bypass": false
    },
    "reverb": {
      "mix": 0.35,
      "size": 0.65,
      "damping": 0.35
    },
    "output": {
      "level": 0.25
    }
  },
  "knobs": [
    "default",
    "default",
    "default",
    "default"
  ],
  "harmony": {
    "enabled": false,
    "tonic": "C",
    "mode": "major",
    "extension": "triad",
    "inversion": 0,
    "open": false,
    "voice_leading": true,
    "layout": "static"
  },
  "parts": {
    "arp": {
      "pattern": "up",
      "rate": "1/16",
      "octaves": 2,
      "gate": 50,
      "latch": true
    },
    "bass": {
      "mode": "root",
      "rate": "1/4",
      "octave": 2
    },
    "clock": {
      "bpm": 110,
      "seed": 0,
      "send_clock": true
    }
  }
}
