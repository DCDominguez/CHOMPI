{
 "name": "Forge automatic checks (TEST_SESSION steps a computer can measure)",
 "about": "Run from the bridge page (Automatic checks) or: python host/forge_audio.py run. Development firmware. Wiring: CHOMPI main out -> interface inputs; interface outputs -> CHOMPI line in; interface direct monitoring off. Tones are -18 dBFS. Step ids follow docs/forge/TEST_SESSION.md. Without an interface the audio steps are skipped.",
 "steps": [
  {
   "id": "1.3",
   "title": "Identity: firmware 0.6",
   "do": [
    {
     "status": true
    }
   ],
   "check": [
    {
     "status": {
      "firmware": "0.6"
     }
    }
   ]
  },
  {
   "id": "0.n",
   "title": "Noise floor with nothing playing",
   "do": [
    {
     "send": "presets/01-dry.json"
    },
    {
     "capture": {
      "name": "floor",
      "seconds": 1
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "floor",
      "silent": true,
      "clicks_max": 0
     }
    }
   ]
  },
  {
   "id": "2.1",
   "title": "Aux path: line-in tone passes through dry, both channels",
   "do": [
    {
     "send": "presets/01-dry.json"
    },
    {
     "tone": {
      "hz": 1000,
      "seconds": 1.0,
      "capture": "dry"
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "dry",
      "pitch_hz": [
       995,
       1005
      ],
      "silent": false,
      "clicks_max": 0,
      "channels.1.pitch_hz": [
       995,
       1005
      ]
     }
    }
   ]
  },
  {
   "id": "2.2",
   "title": "Aux path: slap echo extends the tone",
   "do": [
    {
     "send": "presets/02-slap.json"
    },
    {
     "tone": {
      "hz": 440,
      "seconds": 0.3,
      "tail": 1.0,
      "capture": "slap"
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "slap",
      "pitch_hz": [
       437,
       443
      ],
      "end_s": [
       0.4,
       1.3
      ]
     }
    }
   ]
  },
  {
   "id": "2.4",
   "title": "CC 85 bypass: wet path off then on (dry still passes)",
   "do": [
    {
     "send": "presets/03-long-echo.json"
    },
    {
     "cc": [
      85,
      127
     ]
    },
    {
     "tone": {
      "hz": 440,
      "seconds": 0.3,
      "tail": 1.0,
      "capture": "bypassed"
     }
    },
    {
     "cc": [
      85,
      0
     ]
    }
   ],
   "check": [
    {
     "capture": {
      "name": "bypassed",
      "pitch_hz": [
       437,
       443
      ],
      "end_s": [
       0.25,
       0.5
      ]
     }
    }
   ]
  },
  {
   "id": "3.1",
   "title": "Instrument over MIDI: C3, C4, C5 at the right pitch",
   "do": [
    {
     "send": "presets/04-glass-keys.json"
    },
    {
     "play": {
      "notes": [
       48
      ],
      "seconds": 0.6,
      "tail": 0.3,
      "capture": "c3"
     }
    },
    {
     "play": {
      "notes": [
       60
      ],
      "seconds": 0.6,
      "tail": 0.3,
      "capture": "c4"
     }
    },
    {
     "play": {
      "notes": [
       72
      ],
      "seconds": 0.6,
      "tail": 0.3,
      "capture": "c5"
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "c3",
      "pitch_hz": [
       129.5,
       132.2
      ]
     }
    },
    {
     "capture": {
      "name": "c4",
      "pitch_hz": [
       259.0,
       264.3
      ]
     }
    },
    {
     "capture": {
      "name": "c5",
      "pitch_hz": [
       518.0,
       528.5
      ],
      "clicks_max": 0
     }
    }
   ]
  },
  {
   "id": "3.1k",
   "title": "Instrument from the keybed (virtual KEY_8 = MIDI 60)",
   "do": [
    {
     "send": "presets/04-glass-keys.json"
    },
    {
     "capture": {
      "name": "key8",
      "seconds": 1.2,
      "after": 0.1,
      "during": [
       {
        "panel": "hold KEY_8"
       },
       {
        "wait": 0.6
       },
       {
        "panel": "let KEY_8"
       }
      ]
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "key8",
      "pitch_hz": [
       259.0,
       264.3
      ],
      "silent": false
     }
    }
   ]
  },
  {
   "id": "3.4",
   "title": "Five notes on four voices: steal without a click",
   "do": [
    {
     "send": "presets/04-glass-keys.json"
    },
    {
     "play": {
      "notes": [
       60,
       64,
       67,
       71,
       74
      ],
      "seconds": 1.5,
      "tail": 1.0,
      "capture": "steal"
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "steal",
      "silent": false,
      "clicks_max": 0
     }
    }
   ]
  },
  {
   "id": "3.10",
   "title": "Warm Pad (v3) plays; listen for beating, swell and reverb",
   "do": [
    {
     "send": "presets/07-warm-pad.json"
    },
    {
     "play": {
      "notes": [
       57,
       60,
       64
      ],
      "seconds": 2.0,
      "tail": 2.0,
      "capture": "pad"
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "pad",
      "silent": false,
      "clicks_max": 0,
      "end_s": [
       2.2,
       4.0
      ]
     }
    }
   ]
  },
  {
   "id": "3.17",
   "title": "Menu opens: toggle up + hold CHOMPI, bank keys lit",
   "do": [
    {
     "panel": [
      "release all",
      "toggle up",
      "hold CHOMPI"
     ]
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "panel.menu.open": true,
      "panel.menu.page": "presets",
      "panel.logical.overridden": true
     }
    },
    {
     "led": {
      "KEY_16": "lit",
      "KEY_17": "lit"
     }
    }
   ]
  },
  {
   "id": "3.30",
   "title": "Samples page: KEY_22, page key lit, card present",
   "do": [
    {
     "panel": "tap KEY_22"
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "panel.menu.open": true,
      "panel.menu.page": "samples",
      "storage.sd_ready": true
     }
    },
    {
     "led": {
      "KEY_22": "lit"
     }
    }
   ]
  },
  {
   "id": "3.30c",
   "title": "Close the menu and hand the panel back",
   "do": [
    {
     "panel": [
      "tap KEY_22",
      "let CHOMPI",
      "release all"
     ]
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "panel.menu.open": false,
      "panel.logical.overridden": false
     }
    }
   ]
  },
  {
   "id": "3.28",
   "title": "Sample list: card present (TAPE files from 0.6)",
   "do": [
    {
     "samples": true
    }
   ],
   "check": [
    {
     "samples": {
      "card": true,
      "busy": false
     }
    }
   ]
  },
  {
   "id": "3.29",
   "title": "Kit a: white key 1 plays a sample",
   "do": [
    {
     "send": "presets/12-tape-kit-a.json"
    },
    {
     "wait": 3
    },
    {
     "play": {
      "notes": [
       48
      ],
      "seconds": 0.5,
      "tail": 0.5,
      "capture": "kit1"
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "kit1",
      "silent": false
     }
    }
   ]
  },
  {
   "id": "3.34",
   "title": "Record a 440 Hz line-in tone (toggle down + hold CHOMPI), play it back at MIDI 60",
   "do": [
    {
     "send": "presets/01-dry.json"
    },
    {
     "panel": [
      "release all",
      "toggle down",
      "jack in"
     ]
    },
    {
     "tone": {
      "hz": 440,
      "seconds": 3.0,
      "tail": 0.3,
      "capture": "recording",
      "after": 0.3,
      "during": [
       {
        "panel": "hold CHOMPI"
       },
       {
        "wait": 2.0
       },
       {
        "probe": true
       },
       {
        "panel": "let CHOMPI"
       }
      ]
     }
    },
    {
     "panel": "release all"
    },
    {
     "wait": 0.5
    },
    {
     "play": {
      "notes": [
       60
      ],
      "seconds": 1.0,
      "tail": 0.5,
      "capture": "playback"
     }
    },
    {
     "samples": true
    }
   ],
   "check": [
    {
     "probe": {
      "storage.recording": true
     }
    },
    {
     "capture": {
      "name": "playback",
      "pitch_hz": [
       436,
       444
      ],
      "silent": false,
      "clicks_max": 0
     }
    },
    {
     "samples": {
      "recording": true,
      "recording_seconds": [
       1.5,
       2.6
      ]
     }
    }
   ]
  },
  {
   "id": "3.42",
   "title": "Looper: record a line-in tone loop with LOOP / PLAY, it repeats without a click",
   "do": [
    {
     "send": "presets/01-dry.json"
    },
    {
     "panel": [
      "release all",
      "toggle down"
     ]
    },
    {
     "tone": {
      "hz": 1000,
      "seconds": 2.0,
      "tail": 0.2,
      "capture": "loop_in",
      "after": 0.3,
      "during": [
       {
        "panel": "tap KEY_28"
       },
       {
        "wait": 1.0
       },
       {
        "panel": "tap KEY_27"
       }
      ]
     }
    },
    {
     "capture": {
      "name": "loop_out",
      "seconds": 2.0
     }
    },
    {
     "probe": true
    },
    {
     "panel": [
      "hold KEY_27",
      "hold KEY_28"
     ]
    },
    {
     "wait": 2.3
    },
    {
     "panel": [
      "let KEY_27",
      "let KEY_28",
      "release all"
     ]
    }
   ],
   "check": [
    {
     "probe": {
      "storage.looper.state": "playing",
      "storage.looper.length_frames": [
       40000,
       60000
      ]
     }
    },
    {
     "capture": {
      "name": "loop_out",
      "pitch_hz": [
       990,
       1010
      ],
      "silent": false,
      "clicks_max": 0
     }
    }
   ]
  },
  {
   "id": "3.42s",
   "title": "Looper states via the virtual keys (first take, playback, overdub, pause)",
   "do": [
    {
     "panel": [
      "release all",
      "tap KEY_28"
     ]
    },
    {
     "wait": 0.6
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "storage.looper.state": "first_take"
     }
    }
   ],
   "realtime": true
  },
  {
   "id": "3.43",
   "title": "LOOP ends the first take straight into overdub (TAPE)",
   "do": [
    {
     "panel": "tap KEY_28"
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "storage.looper.state": "playing",
      "storage.looper.overdub": true
     }
    }
   ],
   "realtime": true
  },
  {
   "id": "3.44",
   "title": "PLAY: overdub off, then pause",
   "do": [
    {
     "panel": [
      "tap KEY_27",
      "tap KEY_27"
     ]
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "storage.looper.state": "paused",
      "storage.looper.overdub": false
     }
    }
   ],
   "realtime": true
  },
  {
   "id": "3.45",
   "title": "Hold PLAY + LOOP 2 s: the loop is cleared",
   "do": [
    {
     "panel": [
      "hold KEY_27",
      "hold KEY_28"
     ]
    },
    {
     "wait": 2.3
    },
    {
     "panel": [
      "let KEY_27",
      "let KEY_28",
      "release all"
     ]
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "storage.looper.state": "empty",
      "storage.looper.length_frames": 0
     }
    }
   ],
   "realtime": true
  },
  {
   "id": "3.52",
   "title": "Knob pages: pressing knob 1 (SW4) steps it to page 2 (cutoff), its LED turns red",
   "do": [
    {
     "send": "presets/07-warm-pad.json"
    },
    {
     "panel": [
      "release all",
      "tap ENC_4_SW"
     ]
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "panel.knob_pages": [
       2,
       1,
       1,
       1
      ],
      "panel.knobs.0.control": "filter.cutoff_hz",
      "panel.knobs.1.control": "delay.time_ms"
     }
    }
   ]
  },
  {
   "id": "3.53",
   "title": "Knob pages are per knob and wrap back to page 1",
   "do": [
    {
     "panel": [
      "tap ENC_1_SW",
      "tap ENC_4_SW",
      "tap ENC_4_SW",
      "tap ENC_4_SW"
     ]
    },
    {
     "probe": true
    },
    {
     "panel": [
      "tap ENC_1_SW",
      "tap ENC_1_SW",
      "tap ENC_1_SW"
     ]
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "panel.knob_pages": [
       1,
       1,
       1,
       1
      ],
      "panel.knobs.1.control": "delay.time_ms"
     }
    }
   ]
  },
  {
   "id": "3.55",
   "title": "v5 patch knobs: Knob Pad puts the cutoff on knob 1, page 1; turning it opens the filter",
   "do": [
    {
     "send": "presets/14-knob-pad.json"
    },
    {
     "panel": [
      "release all",
      "turn KNOB_1 +20"
     ]
    },
    {
     "probe": true
    }
   ],
   "check": [
    {
     "probe": {
      "engine.patch.version": 5,
      "engine.patch.knobs": [
       "filter.cutoff_hz",
       "lfo.rate_hz",
       "reverb.size",
       "reverb.mix"
      ],
      "panel.knobs.0.control": "filter.cutoff_hz",
      "engine.patch.modules.filter.cutoff_hz": [
       1500,
       16000
      ]
     }
    }
   ]
  },
  {
   "id": "4.1",
   "title": "Panic stops voices, echoes and reverb at once",
   "do": [
    {
     "send": "presets/07-warm-pad.json"
    },
    {
     "play": {
      "notes": [
       60,
       64,
       67
      ],
      "seconds": 1.0,
      "tail": 0,
      "capture": "before"
     }
    },
    {
     "panic": true
    },
    {
     "capture": {
      "name": "after",
      "seconds": 0.5
     }
    }
   ],
   "check": [
    {
     "capture": {
      "name": "before",
      "silent": false
     }
    },
    {
     "capture": {
      "name": "after",
      "silent": true
     }
    }
   ]
  },
  {
   "id": "6.2b",
   "title": "CPU worst case: cpu-stress, four notes for 20 s",
   "do": [
    {
     "send": "presets/10-cpu-stress.json"
    },
    {
     "play": {
      "notes": [
       48,
       55,
       60,
       64
      ],
      "seconds": 20,
      "tail": 1,
      "capture": "stress"
     }
    },
    {
     "status": true
    }
   ],
   "check": [
    {
     "status": {
      "cpu_max_percent": [
       0,
       100
      ],
      "dropped": 0
     }
    },
    {
     "capture": {
      "name": "stress",
      "clicks_max": 0
     }
    }
   ]
  },
  {
   "id": "6.2c",
   "title": "Sampler worst case: seven voices on the recording for 20 s",
   "do": [
    {
     "send": "presets/13-sampler-stress.json"
    },
    {
     "wait": 1
    },
    {
     "play": {
      "notes": [
       48,
       50,
       52,
       53,
       55,
       57,
       59
      ],
      "seconds": 20,
      "tail": 1,
      "capture": "sampler"
     }
    },
    {
     "status": true
    }
   ],
   "check": [
    {
     "status": {
      "cpu_max_percent": [
       0,
       100
      ],
      "dropped": 0
     }
    }
   ]
  },
  {
   "id": "6.3",
   "title": "Back to dry aux",
   "do": [
    {
     "panic": true
    },
    {
     "send": "presets/01-dry.json"
    },
    {
     "status": true
    }
   ],
   "check": [
    {
     "status": {
      "patch.parameters.mix": [
       0,
       0.01
      ]
     }
    }
   ]
  }
 ]
}
