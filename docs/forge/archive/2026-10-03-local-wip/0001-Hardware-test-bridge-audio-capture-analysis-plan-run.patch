+# ---- Development firmware only (make firmware-dev): panel injection and probe ----
+# Upstream SwId order (chompi hardware.h). CHOMPI = KEY_26.
+PANEL_BUTTONS = {name: index for index, name in enumerate((
+    "ENC_1_SW", "ENC_2_SW", "ENC_3_SW", "ENC_4_SW", "NC_6", "CHOMPI", "SW_TOG", "KEY_16",
+    "KEY_2", "KEY_3", "KEY_4", "KEY_5", "KEY_17", "KEY_18", "KEY_19", "KEY_1",
+    "KEY_6", "KEY_7", "KEY_8", "KEY_9", "KEY_10", "KEY_20", "KEY_21", "KEY_22",
+    "KEY_11", "KEY_12", "KEY_13", "KEY_14", "KEY_15", "KEY_23", "KEY_24", "KEY_25",
+    "ENC_6_SW", "KEY_27", "KEY_28"))}
+# Logical knobs 1-4 (stock order) are hardware encoders SW4, SW1, SW2, SW3; SW5 tone, SW6 volume.
+PANEL_ENCODERS = {"KNOB_1": 3, "KNOB_2": 0, "KNOB_3": 1, "KNOB_4": 2, "SW5": 4, "SW6": 5}
+PANEL_KINDS = ("key", "turn", "press", "toggle", "jack", "release")
+
+
+def key_led(name):
+    """Index of the SMT LED under a key (25 key LEDs; 25 = the CHOMPI key LED in probe page 1)."""
+    if name == "CHOMPI": return 25
+    number = int(name.split("_")[1])
+    if 1 <= number <= 15: return 25 - number                     # white keys: TAPE's 25 - slot#
+    if 16 <= number <= 25: return number - 16                    # black keys KEY_16..25
+    raise ValueError(f"{name} has no key LED")
+
+
+def panel_message(sequence, kind, target=None, value=0):
+    """Opcode 0A: key (target name/id, value 1 down / 0 up), turn (encoder, ±63), press (SW5),
+    toggle/jack (1, 0, or -1 = hardware again), release (all overrides)."""
+    if kind not in PANEL_KINDS: raise ValueError("Panel kind must be one of " + ", ".join(PANEL_KINDS))
+    ident = 0
+    if kind == "key":
+        ident = PANEL_BUTTONS.get(target, target)
+        if type(ident) is not int or not 0 <= ident < 40 or value not in (0, 1): raise ValueError("Unknown key or value")
+    elif kind == "turn":
+        ident = PANEL_ENCODERS.get(target, target)
+        if type(ident) is not int or not 0 <= ident < 6 or type(value) is not int or not -63 <= value <= 63:
+            raise ValueError("Turn needs an encoder and an increment -63..63")
+    elif kind == "press":
+        ident, value = 4, 0
+    elif kind in ("toggle", "jack"):
+        if value not in (-1, 0, 1): raise ValueError("Toggle/jack value must be 1, 0 or -1 (hardware)")
+    else:
+        value = 0
+    return message(0x0A, sequence, [PANEL_KINDS.index(kind), ident, value + 64])
+
+
+def probe_message(sequence, page=0):
+    if page not in (0, 1): raise ValueError("Probe page must be 0 (state) or 1 (LEDs)")
+    return message(0x0B, sequence, [page])
+
+
+def decode_menu(packed):
+    """PresetMenu::Packed() fields (core/preset_menu.h)."""
+    modes = ("none", "save", "erase", "copy_source", "copy_dest")
+    return {"open": bool(packed & 1), "mode": modes[(packed >> 1) & 7] if (packed >> 1) & 7 < 5 else "invalid",
+            "page": "samples" if packed >> 21 & 1 else "presets", "bank": (packed >> 4) & 7,
+            "sample_mode": SAMPLE_MODES[packed >> 22 & 1], "record_source": ("mic", "line", "resample", "?")[packed >> 25 & 3]}
+
