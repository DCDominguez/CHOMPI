index 0000000..dba83a5
--- /dev/null
+++ b/firmware/chompi-forge/tests/test_bridge.py
@@ -0,0 +1,182 @@
+"""Hardware test bridge (host/forge_bridge.py): analysis, gestures and plans,
+run against the simulated CHOMPI (forge_probe built with the development hooks)
+and fake audio. No audio interface or hardware is involved."""
+import json
+from pathlib import Path
+import struct
+import sys
+import tempfile
+import unittest
+import zlib
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "host"))
+sys.path.insert(0, str(ROOT / "tests"))
+
+try:
+    import numpy as np
+    import forge_bridge as bridge
+except ModuleNotFoundError:          # numpy is a bridge-only dependency
+    np = bridge = None
+import sim_device
+
+RATE = 48000
+
+
+def sine(hz, seconds=1.0, amplitude=0.25, channels=2):
+    t = np.arange(int(seconds * RATE)) / RATE
+    x = amplitude * np.sin(2 * np.pi * hz * t)
+    return np.stack([x] * channels, axis=1).astype(np.float32)
+
+
+@unittest.skipIf(np is None, "numpy not installed (pip install -r host/bridge-requirements.txt)")
+class AnalysisTests(unittest.TestCase):
+    def test_pitch_level_and_silence(self):
+        for hz in (55.0, 261.63, 440.0, 3520.0):
+            self.assertAlmostEqual(bridge.analyze(sine(hz))["pitch_hz"], hz, delta=hz * 0.002)
+        a = bridge.analyze(sine(440, amplitude=0.5))
+        self.assertAlmostEqual(a["peak_db"], -6.0, delta=0.1)
+        self.assertAlmostEqual(a["rms_db"], -9.0, delta=0.1)
+        self.assertFalse(a["silent"])
+        self.assertEqual(a["stereo_correlation"], 1.0)
+        quiet = bridge.analyze(np.zeros((RATE, 2), np.float32))
+        self.assertTrue(quiet["silent"]); self.assertIsNone(quiet["pitch_hz"]); self.assertIsNone(quiet["onset_s"])
+        self.assertIsNone(bridge.analyze(bridge.FakeAudio().source(RATE, None))["pitch_hz"])   # -80 dB noise
+
+    def test_onset_clip_and_clicks(self):
+        x = np.zeros((RATE, 2), np.float32); x[RATE // 2:] = np.roll(sine(220, 0.5), -RATE // 880, axis=0)
+        a = bridge.analyze(x)                                # starts at a peak: a step, i.e. a click
+        self.assertAlmostEqual(a["onset_s"], 0.5, delta=0.011)
+        self.assertEqual(a["clicks"], [0.5])
+        smooth = sine(220); self.assertEqual(bridge.analyze(smooth)["clicks"], [])
+        clicked = sine(220, amplitude=0.1).copy(); clicked[12000:] += 0.2
+        self.assertEqual(bridge.analyze(clicked)["clicks"], [0.25])
+        self.assertGreater(bridge.analyze(sine(100, amplitude=1.2))["channels"][0]["clipped"], 0)
+
+    def test_tone_is_bounded_and_faded(self):
+        t = bridge.tone(440, 0.5)
