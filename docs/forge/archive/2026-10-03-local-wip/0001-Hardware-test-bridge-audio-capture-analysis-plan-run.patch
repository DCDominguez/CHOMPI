+#!/usr/bin/env python3
+"""Forge hardware test bridge (development only).
+
+Runs on the computer CHOMPI is connected to (Windows, macOS or Linux). It gives
+a test session "ears" (records CHOMPI's output through an audio interface and
+measures it), a "voice" (plays test tones into CHOMPI's line input) and, with
+the development firmware (`make firmware-dev`), "hands" (presses keys, turns
+knobs and reads back LEDs over SysEx). Test plans are JSON files
+(tests/hardware/*.json); each run writes a report folder (report.json,
+summary.md, WAV captures, spectrogram PNGs) that people and agents can read.
+
+Needs: python -m pip install -r host/requirements.txt -r host/bridge-requirements.txt
+Nothing here is used by the instrument itself.
+"""
+import argparse
+import datetime
+import json
+import math
+from pathlib import Path
+import secrets
+import struct
+import sys
+import time
+import wave
+import zlib
+
+import numpy as np
+
+import forge_host as host
+
+RATE = 48000
+MAX_TONE_DB = -6.0          # never drive CHOMPI's input harder than this
+
+
+# ---- audio -------------------------------------------------------------------
+class SoundDeviceAudio:
+    """Audio interface via sounddevice (PortAudio; on Windows prefer the WASAPI devices)."""
+    def __init__(self, input_name, output_name=None, channels=2):
+        import sounddevice as sd
+        self.sd, self.channels = sd, channels
+        self.input = self.find(input_name, "max_input_channels")
+        self.output = self.find(output_name, "max_output_channels") if output_name else None
+
+    def find(self, name, kind):
+        matches = [i for i, d in enumerate(self.sd.query_devices()) if d[kind] > 0 and name.lower() in d["name"].lower()]
+        if not matches: raise ValueError(f"No audio device matches '{name}'; run: forge_bridge.py devices")
+        return matches[0]
+
+    def start(self, seconds, play=None):
+        frames = int(seconds * RATE)
+        if play is None:
+            self.pending = self.sd.rec(frames, samplerate=RATE, channels=self.channels, dtype="float32", device=self.input)
+        else:
+            if self.output is None: raise ValueError("Playing a tone needs --audio-out")
+            padded = np.zeros((frames, 2), dtype=np.float32); padded[:min(frames, len(play))] = play[:frames]
+            self.pending = self.sd.playrec(padded, samplerate=RATE, channels=self.channels, dtype="float32",
+                                           device=(self.input, self.output))
+
+    def wait(self):
+        self.sd.wait()
+        return np.asarray(self.pending, dtype=np.float32).reshape(-1, self.channels)
+
+
+class FakeAudio:
+    """Stand-in for tests and --sim: returns `source(frames, play)` (default: faint noise)."""
+    def __init__(self, source=None):
+        rng = np.random.default_rng(1)
+        self.source = source or (lambda frames, play: (rng.standard_normal((frames, 2)) * 1e-4).astype(np.float32))
+
+    def start(self, seconds, play=None): self.result = self.source(int(seconds * RATE), play)
+    def wait(self): return self.result
+
+
+def list_devices():
+    import sounddevice as sd
+    apis = sd.query_hostapis()
+    return [{"index": i, "name": d["name"], "api": apis[d["hostapi"]]["name"],
+             "inputs": d["max_input_channels"], "outputs": d["max_output_channels"]} for i, d in enumerate(sd.query_devices())]
+
+
+def tone(hz, seconds, db=-18.0):
+    if not db <= MAX_TONE_DB: raise ValueError(f"Tone level must be at most {MAX_TONE_DB} dBFS")
+    t = np.arange(int(seconds * RATE)) / RATE
+    x = (10 ** (db / 20)) * np.sin(2 * np.pi * hz * t)
+    fade = min(len(x) // 2, int(0.01 * RATE))
+    if fade: x[:fade] *= np.linspace(0, 1, fade); x[-fade:] *= np.linspace(1, 0, fade)
+    return np.stack([x, x], axis=1).astype(np.float32)
+
+
+# ---- files ------------------------------------------------------------------
+def write_wav(path, x):
+    data = (np.clip(x, -1, 1) * 32767).astype("<i2")
+    with wave.open(str(path), "wb") as f:
+        f.setnchannels(data.shape[1]); f.setsampwidth(2); f.setframerate(RATE); f.writeframes(data.tobytes())
+
+
+def read_wav(path):
+    with wave.open(str(path), "rb") as f:
+        width, channels, rate, raw = f.getsampwidth(), f.getnchannels(), f.getframerate(), f.readframes(f.getnframes())
+    if width == 2: x = np.frombuffer(raw, "<i2").astype(np.float32) / 32768
+    elif width == 3:
+        b = np.frombuffer(raw, np.uint8).reshape(-1, 3)
+        x = ((b[:, 0].astype(np.int32) | (b[:, 1].astype(np.int32) << 8) | (b[:, 2].astype(np.int32) << 16)) << 8 >> 8) / 8388608.0
+    else: raise ValueError("Only 16/24-bit PCM WAV files")
+    return x.reshape(-1, channels).astype(np.float32), rate
+
+
+def write_png(path, image):
+    """Minimal greyscale/RGB PNG writer (no image library needed)."""
+    image = np.asarray(image, dtype=np.uint8)
+    height, width = image.shape[:2]
+    color = 2 if image.ndim == 3 else 0
+    rows = b"".join(b"\0" + image[y].tobytes() for y in range(height))
+    def chunk(kind, data): return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff)
+    Path(path).write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, color, 0, 0, 0))
+                           + chunk(b"IDAT", zlib.compress(rows, 9)) + chunk(b"IEND", b""))
+
+
+# ---- analysis -----------------------------------------------------------------
+def db(value): return round(20 * math.log10(max(float(value), 1e-9)), 1)
+
+
+def pitch(x, rate=RATE):
+    """Dominant frequency (Hz) of the loudest 0.5 s, parabolic-interpolated FFT peak; None below -60 dBFS."""
+    n = min(len(x), rate // 2)
+    if n < 2048: return None
+    hop = max(1, n // 4)
+    starts = range(0, len(x) - n + 1, hop)
+    start = max(starts, key=lambda s: float(np.sum(x[s:s + n] ** 2)))
+    seg = x[start:start + n] - np.mean(x[start:start + n])
+    if np.sqrt(np.mean(seg ** 2)) < 1e-3: return None     # below -60 dBFS: no pitch
+    spectrum = np.abs(np.fft.rfft(seg * np.hanning(n)))
+    spectrum[:int(20 * n / rate)] = 0
+    k = int(np.argmax(spectrum))
+    if 0 < k < len(spectrum) - 1:
+        a, b, c = np.log(spectrum[k - 1:k + 2] + 1e-12)
+        k = k + 0.5 * (a - c) / (a - 2 * b + c)
+    return round(float(k * rate / n), 2)
+
+
+def clicks(x, rate=RATE):
+    """Isolated discontinuities: second differences far above their local level (10 ms windows)."""
+    if len(x) < 3: return []
+    d2 = np.abs(x[2:] - 2 * x[1:-1] + x[:-2])
+    window = int(0.01 * rate)
+    found = []
+    for start in range(0, len(d2) - window + 1, window):
+        w = d2[start:start + window]
+        peak = int(np.argmax(w))
+        rest = np.delete(w, slice(max(0, peak - 2), peak + 3))
+        level = np.sqrt(np.mean(rest ** 2)) if len(rest) else 0.0
+        if w[peak] > 0.02 and w[peak] > 10 * max(level, 1e-6):
+            found.append(round((start + peak + 1) / rate, 4))
+    return found
+
+
+def analyze(x, rate=RATE):
+    x = np.asarray(x, dtype=np.float64)
+    if x.ndim == 1: x = x[:, None]
+    result = {"seconds": round(len(x) / rate, 3), "channels": []}
+    for c in range(x.shape[1]):
+        s = x[:, c]
+        envelope = np.sqrt(np.convolve(s ** 2, np.ones(480) / 480, mode="valid")) if len(s) >= 480 else np.abs(s)
+        loud = np.nonzero(envelope > 10 ** (-50 / 20))[0]
+        quiet = np.sort(envelope)[: max(1, len(envelope) // 10)]
+        result["channels"].append({
+            "peak_db": db(np.max(np.abs(s))) if len(s) else -180, "rms_db": db(np.sqrt(np.mean(s ** 2))) if len(s) else -180,
+            "dc": round(float(np.mean(s)), 5), "clipped": int(np.sum(np.abs(s) >= 0.999)),
+            "pitch_hz": pitch(s, rate), "noise_floor_db": db(np.mean(quiet)),
+            "onset_s": round(loud[0] / rate, 4) if len(loud) else None,
+            "end_s": round((loud[-1] + 480) / rate, 4) if len(loud) else None,
+            "clicks": clicks(s, rate)[:20]})
+    if x.shape[1] == 2 and np.std(x[:, 0]) > 1e-6 and np.std(x[:, 1]) > 1e-6:
+        result["stereo_correlation"] = round(float(np.corrcoef(x[:, 0], x[:, 1])[0, 1]), 3)
+    left = result["channels"][0]
+    result.update({key: left[key] for key in ("peak_db", "rms_db", "pitch_hz", "onset_s", "noise_floor_db")})
+    result["clicks"] = sorted({t for ch in result["channels"] for t in ch["clicks"]})
+    result["silent"] = all(ch["rms_db"] < -60 for ch in result["channels"])
+    return result
+
+
+def spectrogram(x, path, rate=RATE, top_hz=12000):
+    """Log-magnitude spectrogram of the mono sum as a PNG (time left to right, low notes at the bottom)."""
+    mono = np.asarray(x, dtype=np.float64).reshape(len(x), -1).mean(axis=1)
+    size, hop = 2048, 512
+    if len(mono) < size: mono = np.pad(mono, (0, size - len(mono)))
+    frames = [np.abs(np.fft.rfft(mono[i:i + size] * np.hanning(size))) for i in range(0, len(mono) - size + 1, hop)]
+    s = 20 * np.log10(np.array(frames).T[: int(top_hz * size / rate)] + 1e-9)
+    s = np.clip((s - (s.max() - 90)) / 90, 0, 1)
+    rows = np.linspace(0, s.shape[0] - 1, 256).astype(int)
+    cols = np.linspace(0, s.shape[1] - 1, min(1200, s.shape[1])).astype(int)
+    write_png(path, (255 * s[rows][:, cols][::-1]).astype(np.uint8))
+
+
+# ---- device ------------------------------------------------------------------------
+class Device:
+    """CHOMPI over MIDI with ONE input and ONE output held open for the whole run
+    (Windows MIDI ports are exclusive: close the webapp and DAWs first)."""
+    def __init__(self, input_name, output_name, midi=None, timeout=2.0):
+        self.midi = midi or host.midi_module()
+        if input_name not in self.midi.get_input_names() or output_name not in self.midi.get_output_names():
+            raise ValueError("MIDI port not found; run: forge_host.py ports, and copy the exact names")
+        self.source, self.destination = self.midi.open_input(input_name), self.midi.open_output(output_name)
+        self.timeout = timeout
+
+    def close(self):
+        for port in (self.source, self.destination):
+            close = getattr(port, "close", None)
+            if close: close()
+
+    def request(self, payload):
+        sequence = host.read14(payload, 5)
+        self.destination.send(self.midi.Message("sysex", data=payload))
+        deadline = time.monotonic() + self.timeout
+        while time.monotonic() < deadline:
+            reply = self.source.receive(block=False)
+            if reply is None: time.sleep(0.002); continue
+            data = list(getattr(reply, "data", ()))
+            if reply.type == "sysex" and len(data) >= 7 and data[:3] == host.PREFIX[:3] and host.read14(data, 5) == sequence:
+                return host.decode_response(data, sequence)
+        raise TimeoutError("No reply from CHOMPI (is the development firmware installed for panel/probe steps?)")
+
+    def seq(self): return secrets.randbelow(16384)
+    def send_patch(self, patch): return self.request(host.encode_patch(patch, self.seq()))
+    def status(self): return self.request(host.message(2, self.seq()))
+    def panic(self): return self.request(host.message(3, self.seq()))
+    def panel(self, kind, target=None, value=0): return self.request(host.panel_message(self.seq(), kind, target, value))
+    def probe(self, page=0): return self.request(host.probe_message(self.seq(), page))
+    def samples(self): return self.request(host.sample_message(8, self.seq()))
+    def sample_job(self, *args): return self.request(host.sample_message(9, self.seq(), *args))
+    def note(self, note, velocity):
+        kind = "note_on" if velocity else "note_off"
+        self.destination.send(self.midi.Message(kind, channel=0, note=note, velocity=velocity))
+    def cc(self, number, value): self.destination.send(self.midi.Message("control_change", channel=0, control=number, value=value))
+
+
+def panel_gesture(text):
+    """'toggle up|down|hw', 'jack in|out|hw', 'hold X', 'let X', 'tap X', 'turn KNOB_1 +10', 'press SW5', 'release all'."""
+    words = text.split()
+    if len(words) == 2 and words[0] in ("toggle", "jack"):
+        value = {"up": 1, "in": 1, "down": 0, "out": 0, "hw": -1}.get(words[1])
+        if value is None: raise ValueError(f"Bad panel step: {text}")
+        return [(words[0], None, value)]
+    if len(words) == 2 and words[0] in ("hold", "let"): return [("key", words[1], 1 if words[0] == "hold" else 0)]
+    if len(words) == 2 and words[0] == "tap": return [("key", words[1], 1), ("key", words[1], 0)]
+    if len(words) == 3 and words[0] == "turn": return [("turn", words[1], int(words[2]))]
+    if text in ("press SW5", "release all"): return [("press" if text.startswith("press") else "release", None, 0)]
+    raise ValueError(f"Bad panel step: {text}")
+
+
+# ---- plans --------------------------------------------------------------------------
+def lookup(data, dotted):
+    for part in dotted.split("."):
+        data = data[int(part) if isinstance(data, list) else part]
+    return data
+
+
+def compare(expected, actual):
+    if isinstance(expected, list) and len(expected) == 2 and all(isinstance(v, (int, float)) for v in expected) \
+            and not isinstance(actual, list):
+        return actual is not None and expected[0] <= actual <= expected[1]
+    return expected == actual
+
+
+class Runner:
+    def __init__(self, device, audio, report_dir, ask=input, root=None, unattended=False):
+        self.device, self.audio, self.ask, self.unattended = device, audio, ask, unattended
+        self.report = Path(report_dir); self.report.mkdir(parents=True, exist_ok=True)
+        self.root = Path(root or Path(__file__).resolve().parents[1])
+        self.captures, self.last = {}, {}
+
+    def run(self, plan):
+        steps = []
+        for step in plan["steps"]:
+            entry = {"id": step["id"], "title": step.get("title", ""), "log": [], "checks": [], "result": "pass"}
+            try:
+                for action in step.get("do", []): self.action(action, entry)
+                for check in step.get("check", []): self.check(check, entry)
+                if "ask" in step:
+                    if self.unattended: entry["human"] = "not asked (unattended)"; entry["result"] = "needs-human"
+                    else:
+                        answer = self.ask(f"[{step['id']}] {step['ask']} (y/n, then notes): ").strip()
+                        entry["human"] = answer
+                        if not answer.lower().startswith("y"): entry["result"] = "fail"
+            except Exception as error:   # a broken step must not stop the session
+                entry["result"], entry["error"] = "error", f"{type(error).__name__}: {error}"
+            if any(not c["ok"] for c in entry["checks"]) and entry["result"] == "pass": entry["result"] = "fail"
+            steps.append(entry)
+            print(f"{entry['id']:>6}  {entry['result']:<11} {entry['title']}", flush=True)
+        counts = {k: sum(s["result"] == k for s in steps) for k in ("pass", "fail", "error", "needs-human")}
+        result = {"plan": plan.get("name", ""), "started": plan.get("_started"), "counts": counts, "steps": steps}
+        (self.report / "report.json").write_text(json.dumps(result, indent=2) + "\n")
+        lines = [f"# {result['plan']}", "", f"pass {counts['pass']} · fail {counts['fail']} · error {counts['error']} · needs-human {counts['needs-human']}", ""]
+        for s in steps:
+            lines.append(f"- **{s['id']}** {s['result']}: {s['title']}" + (f" — {s.get('error')}" if s.get("error") else ""))
+            for c in s["checks"]:
+                if not c["ok"]: lines.append(f"  - expected {c['what']} = {c['expected']}, got {c['actual']}")
+        (self.report / "summary.md").write_text("\n".join(lines) + "\n")
+        return result
+
+    def action(self, action, entry):
+        (kind, arg), = action.items()
+        entry["log"].append(action)
+        if kind == "wait": time.sleep(float(arg))
+        elif kind == "send":
+            patch = host.load_patch(self.root / arg["file"]) if isinstance(arg, dict) else host.load_patch(self.root / arg)
+            for dotted, value in (arg.get("set", {}) if isinstance(arg, dict) else {}).items():
+                *path, last = dotted.split("."); node = patch
+                for part in path: node = node[part]
+                node[last] = value
+            self.last["status"] = self.device.send_patch(host.validate_patch(patch))
+        elif kind == "status": self.last["status"] = self.device.status()
+        elif kind == "panic": self.last["status"] = self.device.panic()
+        elif kind == "panel":
+            for gesture in (arg if isinstance(arg, list) else [arg]):
+                for k, target, value in panel_gesture(gesture):
+                    self.device.panel(k, target, value); time.sleep(0.03)
+        elif kind == "probe":
+            time.sleep(0.08)                                 # LEDs redraw at ~30 Hz
+            self.last["probe"] = self.device.probe(0); self.last["leds"] = self.device.probe(1)["leds"]
+        elif kind == "samples": self.last["samples"] = self.device.samples()
+        elif kind == "sample": self.last["sample"] = self.device.sample_job(*arg)
+        elif kind == "cc": self.device.cc(*arg)
+        elif kind == "play":                                 # notes held while recording CHOMPI's output
+            seconds, tail = float(arg.get("seconds", 1)), float(arg.get("tail", 0.5))
+            self.audio.start(seconds + tail)
+            for n in arg["notes"]: self.device.note(n, arg.get("velocity", 100))
+            time.sleep(seconds)
+            for n in arg["notes"]: self.device.note(n, 0)
+            self.store(arg["capture"], self.audio.wait(), entry)
+        elif kind == "capture":                              # plain recording, optionally while other actions run
+            self.audio.start(float(arg["seconds"])); self.during(arg, entry); self.store(arg["name"], self.audio.wait(), entry)
+        elif kind == "tone":                                 # test tone into CHOMPI's line input, recorded at the same time
+            self.audio.start(float(arg["seconds"]) + float(arg.get("tail", 0.5)), tone(arg["hz"], arg["seconds"], arg.get("db", -18)))
+            self.during(arg, entry); self.store(arg["capture"], self.audio.wait(), entry)
+        else: raise ValueError(f"Unknown action {kind}")
+
+    def during(self, arg, entry):
+        """Actions run while a recording is in progress ("after" seconds in; keep them shorter than the recording)."""
+        if "during" in arg:
+            time.sleep(float(arg.get("after", 0.2)))
+            for step in arg["during"]: self.action(step, entry)
+
+    def store(self, name, x, entry):
+        write_wav(self.report / f"{entry['id']}-{name}.wav", x)
+        spectrogram(x, self.report / f"{entry['id']}-{name}.png")
+        self.captures[name] = analyze(x)
+        entry.setdefault("captures", {})[name] = self.captures[name]
+
+    def check(self, check, entry):
+        (kind, expected), = check.items()
+        if kind == "capture":
+            data = self.captures[expected["name"]]
+            items = {k: v for k, v in expected.items() if k != "name"}
+        elif kind == "led":
+            leds = self.last["leds"]
+            for key, want in expected.items():
+                rgb = leds[host.key_led(key)]
+                ok = (max(rgb) > 8) if want == "lit" else (max(rgb) <= 8) if want == "off" else all(abs(a - b) <= 12 for a, b in zip(rgb, want))
+                entry["checks"].append({"what": f"led {key}", "expected": want, "actual": rgb, "ok": bool(ok)})
+            return
+        else:
+            data = self.last[kind]; items = expected
+        for dotted, want in items.items():
+            if dotted == "clicks_max": actual = len(data["clicks"]); ok = actual <= want
+            else:
+                try: actual = lookup(data, dotted)
+                except (KeyError, IndexError, TypeError): actual = None
+                ok = compare(want, actual)
+            entry["checks"].append({"what": f"{kind}.{dotted}", "expected": want, "actual": actual, "ok": bool(ok)})
+
+
+def cli(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    commands = parser.add_subparsers(dest="command", required=True)
+    commands.add_parser("devices", help="List audio devices (pick an interface; on Windows prefer WASAPI)")
+    analyze_cmd = commands.add_parser("analyze", help="Measure a WAV file (level, pitch, clicks) and draw its spectrogram")
+    analyze_cmd.add_argument("wav")
+    def ports(command, audio=True):
+        command.add_argument("--input", help="CHOMPI MIDI input port (exact name)")
+        command.add_argument("--output", help="CHOMPI MIDI output port (exact name)")
+        if audio:
+            command.add_argument("--audio-in", help="audio input device name (part of it)")
+            command.add_argument("--audio-out", help="audio output device name, to play tones into CHOMPI")
+        command.add_argument("--sim", action="store_true", help="simulated CHOMPI (build/forge_probe) and silent fake audio")
+    run = commands.add_parser("run", help="Run a test plan and write a report folder")
+    run.add_argument("plan"); run.add_argument("--report", help="report folder (default reports/<plan>-<time>)")
+    run.add_argument("--unattended", action="store_true", help="never ask; steps needing a person are marked needs-human")
+    ports(run)
+    capture = commands.add_parser("capture", help="Record CHOMPI's output to a WAV (and analyse it)")
+    capture.add_argument("seconds", type=float); capture.add_argument("wav"); ports(capture)
+    probe = commands.add_parser("probe", help="Development firmware: menu state and LED colours"); ports(probe, False)
+    panel = commands.add_parser("panel", help="Development firmware: e.g. 'tap KEY_22', 'toggle up', 'turn KNOB_1 +5'")
+    panel.add_argument("gesture", nargs="+"); ports(panel, False)
+    args = parser.parse_args(argv)
+    if args.command == "devices":
+        print(json.dumps(list_devices(), indent=2)); return 0
+    if args.command == "analyze":
+        x, rate = read_wav(args.wav)
+        result = analyze(x, rate); spectrogram(x, Path(args.wav).with_suffix(".png"), rate)
+        print(json.dumps(result, indent=2)); return 0
+    if args.sim:
+        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tests"))
+        import sim_device
+        midi = sim_device.SimulatedMido()
+        device = Device(sim_device.INPUT, sim_device.OUTPUT, midi)
+        audio = FakeAudio()
+    else:
+        if not args.input or not args.output: parser.error("--input and --output are required (or --sim)")
+        device = Device(args.input, args.output)
+        audio = SoundDeviceAudio(args.audio_in, getattr(args, "audio_out", None)) if getattr(args, "audio_in", None) else None
+    try:
+        if args.command == "probe":
+            print(json.dumps({"state": device.probe(0), "leds": device.probe(1)["leds"]}, indent=2))
+        elif args.command == "panel":
+            for k, target, value in panel_gesture(" ".join(args.gesture)): device.panel(k, target, value)
+            print("sent")
+        elif args.command == "capture":
+            if audio is None: parser.error("--audio-in is required")
+            audio.start(args.seconds); x = audio.wait(); write_wav(args.wav, x)
+            spectrogram(x, Path(args.wav).with_suffix(".png")); print(json.dumps(analyze(x), indent=2))
+        else:
+            plan = json.loads(Path(args.plan).read_text())
+            plan["_started"] = datetime.datetime.now().isoformat(timespec="seconds")
+            needs_audio = any(next(iter(a)) in ("play", "capture", "tone") for s in plan["steps"] for a in s.get("do", []))
+            if needs_audio and audio is None: parser.error("This plan records audio: pass --audio-in (and --audio-out for tones)")
+            if not args.sim and not args.unattended and any("tone" in a for s in plan["steps"] for a in s.get("do", [])):
+                if not input("Tones will play into CHOMPI's line in at up to -18 dBFS. Volume low, no feedback loop? (y/n): ").lower().startswith("y"):
+                    return 1
+            report = args.report or f"reports/{Path(args.plan).stem}-{plan['_started'].replace(':', '')}"
+            result = Runner(device, audio, report, unattended=args.unattended).run(plan)
+            print(json.dumps(result["counts"]), f"\nreport: {Path(report).resolve()}")
+            return 0 if not result["counts"]["fail"] and not result["counts"]["error"] else 2
+    finally:
+        device.close()
+        if args.sim: midi.close()
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(cli())
+    except (ValueError, RuntimeError, OSError, TimeoutError) as error:
+        print(f"Forge bridge: {error}", file=sys.stderr)
+        sys.exit(1)
